generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Product {
  id             Int              @id @unique(map: "id") @default(autoincrement())
  name           String?          @db.VarChar(255)
  description    String?          @db.Text
  price          Float?
  category_id    Int?
  order_items    OrderItem[]
  product_images ProductImage[]
  categories     Category?      @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "products_ibfk_1")

  @@index([category_id], map: "category_id")
  @@map("products")
}

model Category {
  id       Int       @id @unique(map: "id") @default(autoincrement())
  name     String?   @db.VarChar(255)
  products Product[]

  @@map("categories")
}

model Customer {
  id      Int      @id @unique(map: "id") @default(autoincrement())
  name    String?  @db.VarChar(255)
  address String?  @db.VarChar(500)
  phone   String?  @db.VarChar(20)
  orders  Order[]

  @@map("customers")
}

model OrderItem {
  id         Int     @id @unique(map: "id") @default(autoincrement())
  order_id   Int
  product_id Int
  quantity   Int
  price      Float
  orders     Order   @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "order_items_ibfk_1")
  products   Product @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "order_items_ibfk_2")

  @@index([order_id], map: "order_id")
  @@index([product_id], map: "product_id")
  @@map("order_items")
}

model Order {
  id           Int            @id @unique(map: "id") @default(autoincrement())
  date         DateTime?      @db.DateTime(0)
  customer_id  Int?
  status       OrderStatus?
  total_amount Float?
  order_items  OrderItem[]
  customers    Customer?     @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "orders_ibfk_1")

  @@index([customer_id], map: "customer_id")
  @@map("orders")
}

model ProductImage {
  id         Int       @id @unique(map: "id") @default(autoincrement())
  product_id Int
  image_name String    @db.Text
  created_at DateTime? @default(now()) @db.Timestamp(0)
  products   Product   @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "product_images_ibfk_1")

  @@index([product_id], map: "product_id")
  @@map("product_images")
}

enum OrderStatus {
  delivered
  received
  processing
}
